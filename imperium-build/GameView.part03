        if(action==MotionEvent.ACTION_POINTER_DOWN && e.getPointerCount()==2){
            panning=true; draggingSelection=false; pinchStartDist=pointerDistance(e); pinchStartZoom=zoom; lastTouchX=(e.getX(0)+e.getX(1))/2; lastTouchY=(e.getY(0)+e.getY(1))/2; return true;
        }
        if(action==MotionEvent.ACTION_MOVE){
            if(e.getPointerCount()>=2){
                float cx=(e.getX(0)+e.getX(1))/2, cy=(e.getY(0)+e.getY(1))/2;
                float dx=cx-lastTouchX, dy=cy-lastTouchY;
                camX -= (dx/(ISO_X*zoom))*0.75f; camY -= (dy/(ISO_Y*zoom))*0.45f;
                float d=pointerDistance(e); if(pinchStartDist>20) zoom=clamp(pinchStartZoom*(d/pinchStartDist),0.60f,1.42f);
                lastTouchX=cx; lastTouchY=cy; panning=true; return true;
            }
            lastTouchX=e.getX(); lastTouchY=e.getY();
            if(distance(downX,downY,lastTouchX,lastTouchY)>28) draggingSelection=true;
            return true;
        }
        if(action==MotionEvent.ACTION_UP){
            float x=e.getX(), y=e.getY();
            if(handleHudTap(x,y)) return true;
            if(panning){ panning=false; return true; }
            if(draggingSelection){ selectBox(downX,downY,x,y); draggingSelection=false; return true; }
            handleGameTap(x,y); return true;
        }
        return true;
    }

    private boolean handleMenuTouch(MotionEvent e){
        if(e.getActionMasked()!=MotionEvent.ACTION_UP) return true;
        float x=e.getX(),y=e.getY();
        if(btnEasy.contains(x,y)){difficulty=0;invalidate();}
        else if(btnNormal.contains(x,y)){difficulty=1;invalidate();}
        else if(btnHard.contains(x,y)){difficulty=2;invalidate();}
        else if(btnPlay.contains(x,y)) resetGame(difficulty);
        return true;
    }

    private boolean handleHudTap(float x,float y){
        if(btnTrainVillager.contains(x,y)){ train(UnitType.VILLAGER,50,0,0); return true; }
        if(btnTrainSword.contains(x,y)){ train(UnitType.SWORD,60,0,20); return true; }
        if(btnTrainArcher.contains(x,y)){ train(UnitType.ARCHER,0,45,30); return true; }
        if(btnTrainCavalry.contains(x,y)){ train(UnitType.CAVALRY,90,0,60); return true; }
        return false;
    }

    private void train(UnitType t,float food,float wood,float gold){
        if(playerPop>=50){toast("Limite de população atingido.");return;}
        if(resourcesFood<food||resourcesWood<wood||resourcesGold<gold){toast("Recursos insuficientes.");return;}
        resourcesFood-=food; resourcesWood-=wood; resourcesGold-=gold;
        float x=860+random.nextFloat()*170,y=980+random.nextFloat()*120;
        units.add(makeUnit(nextUnitId(),TEAM_PLAYER,t,x,y)); recountPop(); toast("Unidade treinada.");
    }

    private void handleGameTap(float sx,float sy){
        long now=SystemClock.uptimeMillis();
        boolean doubleTap=now-lastTapTime<310&&distance(sx,sy,lastTapX,lastTapY)<55;
        lastTapTime=now; lastTapX=sx; lastTapY=sy;
        Unit hit=findScreenUnit(sx,sy);
        if(hit!=null){
            if(hit.team==TEAM_PLAYER){
                if(doubleTap){ selected.clear(); for(Unit u:units) if(u.team==TEAM_PLAYER&&u.type==hit.type) selected.add(u.id); }
                else { selected.clear(); selected.add(hit.id); }
            } else if(!selected.isEmpty()){
                for(Integer id:selected){ Unit u=findUnitById(id); if(u!=null){u.targetUnit=hit.id;u.moving=false;} }
            }
            return;
        }
        if(selected.isEmpty()) return;
        PointF world=toWorld(sx,sy,getWidth(),getHeight());
        List<Unit> sel=new ArrayList<>(); for(Integer id:selected){Unit u=findUnitById(id);if(u!=null)sel.add(u);}
        int cols=(int)Math.ceil(Math.sqrt(sel.size())); float spacing=52;
        for(int i=0;i<sel.size();i++){
            int row=i/cols,col=i%cols; Unit u=sel.get(i); u.tx=world.x+(col-(cols-1)/2f)*spacing; u.ty=world.y+(row-(cols-1)/2f)*spacing; u.targetUnit=-1; u.moving=true;
        }
    }

    private void selectBox(float x1,float y1,float x2,float y2){
        RectF r=new RectF(Math.min(x1,x2),Math.min(y1,y2),Math.max(x1,x2),Math.max(y1,y2)); selected.clear();
        int w=getWidth(),h=getHeight(); for(Unit u:units){ if(u.team!=TEAM_PLAYER)continue; PointF s=toScreen(u.x,u.y,w,h); if(r.contains(s.x,s.y-25*zoom))selected.add(u.id); }
    }

    private Unit findScreenUnit(float sx,float sy){
        Unit best=null; float bd=54; int w=getWidth(),h=getHeight();
        for(Unit u:units){PointF s=toScreen(u.x,u.y,w,h);float d=distance(sx,sy,s.x,s.y-25*zoom);if(d<bd){bd=d;best=u;}}
        return best;
    }

    private Unit findUnitById(int id){ if(id<0)return null; for(Unit u:units)if(u.id==id)return u; return null; }

    private PointF toScreen(float wx,float wy,int sw,int sh){
        float rx=wx-camX, ry=wy-camY;
        return new PointF(sw*0.50f+(rx-ry)*ISO_X*zoom, sh*0.52f+(rx+ry)*ISO_Y*zoom);
    }

    private PointF toWorld(float sx,float sy,int sw,int sh){
        float a=(sx-sw*0.50f)/(ISO_X*zoom); float b=(sy-sh*0.52f)/(ISO_Y*zoom);
        return new PointF(camX+(a+b)/2f,camY+(b-a)/2f);
    }

    private static float pointerDistance(MotionEvent e){ if(e.getPointerCount()<2)return 0; return distance(e.getX(0),e.getY(0),e.getX(1),e.getY(1)); }
    private static float distance(float x1,float y1,float x2,float y2){float dx=x2-x1,dy=y2-y1;return(float)Math.sqrt(dx*dx+dy*dy);}
    private static float clamp(float v,float a,float b){return Math.max(a,Math.min(b,v));}
    private void toast(String s){toast=s;toastUntil=SystemClock.uptimeMillis()+2400;}
}
